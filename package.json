{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "setup": "playwright install chromium",
    "doctor": "yarn build && node dist/src/cli/doctor.js",
    "test:unit": "yarn build && node --test dist/tests/unit/*.test.js",
    "test:browser": "playwright test --pass-with-no-tests",
    "check": "yarn lint && yarn typecheck && yarn test:unit && node scripts/schema.mjs --check && yarn test:browser",
    "schema:write": "yarn build && node scripts/schema.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
