{
  "name": "computer-use-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc && node scripts/assets.mjs && vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --project ui/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "setup": "playwright install chromium",
    "doctor": "yarn build && node dist/src/cli/doctor.js",
    "test:unit": "yarn build && node --test dist/tests/unit/*.test.js",
    "test:browser": "playwright test",
    "check": "yarn lint && yarn typecheck && yarn test:unit && node scripts/schema.mjs --check && node scripts/boundaries.mjs && yarn test:browser && yarn verify:evidence",
    "schema:write": "yarn build && node scripts/schema.mjs",
    "target": "yarn build && node dist/demo/server.js",
    "discover": "yarn build && node --env-file-if-exists=.env.local dist/src/cli/discover.js",
    "demo": "yarn build && node --env-file-if-exists=.env.local dist/src/cli/demo.js",
    "verify:evidence": "node scripts/verify-evidence.mjs"
  },
  "dependencies": {
    "openai": "7.13.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
