  "entry": {
    "route": "search",
    "conditions": [
      {
        "kind": "visible",
        "target": "search-screen"
      }
    ]
  },
  "steps": [
    {
      "id": "step-1",
      "action": {
        "kind": "fill",
        "target": "member-field",
        "input": "memberId"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "search-screen"
        },
        {
          "kind": "visible",
          "target": "member-field"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "search-screen"
        },
        {
          "kind": "equalsInput",
          "target": "member-field",
          "input": "memberId"
        }
      ],
      "effect": "reversible"
    },
    {
      "id": "step-2",
      "action": {
        "kind": "click",
        "target": "search-members"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "search-screen"
        },
        {
          "kind": "visible",
          "target": "search-members"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "results-screen"
        }
      ],
      "effect": "read"
    },
    {
      "id": "step-3",
      "action": {
        "kind": "click",
        "target": "open-member"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "results-screen"
        },
        {
          "kind": "visible",
          "target": "open-member"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "member-screen"
        }
      ],
      "effect": "read"
    },
    {
      "id": "step-4",
      "action": {
        "kind": "click",
        "target": "view-savings"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "member-screen"
        },
        {
          "kind": "visible",
          "target": "view-savings"
        },
        {
          "kind": "equalsInput",
          "target": "member-number",
          "input": "memberId"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        }
      ],
      "effect": "read"
    },
    {
      "id": "step-5",
      "action": {
        "kind": "read",
        "target": "balance",
        "output": "availableBalanceMinor"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        },
        {
          "kind": "visible",
          "target": "balance"
        },
        {
          "kind": "equalsInput",
          "target": "member-number",
          "input": "memberId"
        },
        {
          "kind": "equalsLiteral",
          "target": "account-type",
          "value": "savings"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        }
      ],
      "effect": "read"
    },
    {
      "id": "step-6",
      "action": {
        "kind": "read",
        "target": "currency",
        "output": "currency"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        },
        {
          "kind": "visible",
          "target": "currency"
        },
        {
          "kind": "equalsInput",
          "target": "member-number",
          "input": "memberId"
        },
        {
          "kind": "equalsLiteral",
          "target": "account-type",
          "value": "savings"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        }
      ],
      "effect": "read"
    },
    {
      "id": "step-7",
      "action": {
        "kind": "read",
        "target": "account-type",
        "output": "accountType"
      },
      "preconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        },
        {
          "kind": "visible",
          "target": "account-type"
        },
        {
          "kind": "equalsInput",
          "target": "member-number",
          "input": "memberId"
        },
        {
          "kind": "equalsLiteral",
          "target": "account-type",
          "value": "savings"
        }
      ],
      "postconditions": [
        {
          "kind": "visible",
          "target": "savings-screen"
        }
      ],
      "effect": "read"
    }
  ],
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "when": {
        "kind": "visible",
        "target": "member-not-found"
      }
    },
    {
      "code": "ACCOUNT_NOT_FOUND",
      "when": {
        "kind": "visible",
        "target": "account-not-found"
      }
    },
    {
      "code": "VALIDATION_REJECTED",
      "when": {
        "kind": "visible",
        "target": "validation-rejected"
      }
    }
  ],
  "recovery": [
    {
      "when": {
        "kind": "visible",
        "target": "service-notice"
      },
      "action": {
        "kind": "click",
        "target": "dismiss-notice"
      },
      "postconditions": [
        {
          "kind": "absent",
          "target": "service-notice"
        },
        {
          "kind": "visible",
          "target": "member-screen"
        }
      ],
      "maxAttempts": 1
    }
  ],
  "success": [
    {
      "kind": "visible",
      "target": "savings-screen"
    },
    {
      "kind": "equalsInput",
      "target": "member-number",
      "input": "memberId"
    },
    {
      "kind": "equalsLiteral",
      "target": "account-type",
      "value": "savings"
    }
  ],
